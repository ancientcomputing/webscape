{
  "name": "webscape-wanderer",
  "productName": "Webscape Wanderer",
  "version": "0.1.0",
  "description": "A private-by-default Chromium browser: every tab has its own memory, nothing touches disk, vertical tabs, built-in password vault.",
  "main": "dist/main/main.js",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json && node scripts/copy-static.mjs",
    "start": "node scripts/dev-app-name.mjs && npm run build && npm run build:ai && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "dist": "npm run build && npm run build:ai && electron-builder",
    "icon": "npx electron scripts/render-icon.cjs",
    "test:vault": "npm run build && electron scripts/vault-test.cjs",
    "test:bookmarks": "npm run build && electron scripts/bookmarks-test.cjs",
    "test": "npm run build && electron scripts/vault-test.cjs && electron scripts/bookmarks-test.cjs",
    "build:ai": "node scripts/build-ai.mjs"
  },
  "build": {
    "appId": "org.webscape.wanderer",
    "productName": "Webscape Wanderer",
    "files": [
      "dist/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "extraResources": [
        {
          "from": "native/webscape-ai/.build/release/webscape-ai",
          "to": "webscape-ai/webscape-ai"
        },
        {
          "from": "native/webscape-ai/.build/release/LocalLMLabSDKCore.framework",
          "to": "webscape-ai/LocalLMLabSDKCore.framework"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ancientcomputing/webscape.git"
  },
  "homepage": "https://github.com/ancientcomputing/webscape",
  "bugs": {
    "url": "https://github.com/ancientcomputing/webscape/issues"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": false
  }
}
